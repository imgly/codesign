{
  "description": "Records the session's model for CoDesign's error reports and usage telemetry; turn off the plugin's two IMG.LY settings, or set DO_NOT_TRACK=1 or IMGLY_TELEMETRY=off, to send neither.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/record-model.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "IMGLY_CODESIGN_CHANNEL=next sh \"${CLAUDE_PLUGIN_ROOT}/runtime/codesign.sh\" bootstrap ensure --detach",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/record-model.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
