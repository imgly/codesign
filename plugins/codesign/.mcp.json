{
  "mcpServers": {
    "codesign": {
      "command": "${CLAUDE_PLUGIN_ROOT}/runtime/codesign",
      "args": [
        "mcp"
      ],
      "env": {
        "IMGLY_PLUGIN_ERROR_REPORTING": "${user_config.error_reports}",
        "IMGLY_PLUGIN_TELEMETRY": "${user_config.usage_telemetry}",
        "IMGLY_CODESIGN_CHANNEL": "next"
      }
    }
  }
}
