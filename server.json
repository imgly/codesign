{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.imgly/codesign",
  "description": "Generate vector designs and print-ready PDFs with a CE.SDK CreativeEngine, over MCP.",
  "repository": {
    "url": "https://github.com/imgly/codesign",
    "source": "github"
  },
  "version": "0.1.8",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@imgly/codesign-mcp",
      "version": "0.1.8",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio",
          "valueHint": "stdio",
          "description": "Run the server over stdio (the transport MCP hosts spawn)."
        }
      ]
    }
  ]
}
